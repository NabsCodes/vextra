# Core app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Email delivery
RESEND_API_KEY=re_xxxxxxxxx

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# Cloudflare Turnstile (public enquiry form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<your-site-key>
TURNSTILE_SECRET_KEY=<your-secret-key>

# Optional overrides
WAITLIST_NOTIFICATION_EMAIL=info@vextralimited.com
WAITLIST_NOTIFICATION_TIMEZONE=Africa/Lagos
WAITLIST_NOTIFICATION_LOCALE=en-NG
ENQUIRY_NOTIFICATION_EMAIL=info@vextralimited.com
